// Vibecheck database schema (PostgreSQL).
// Set DATABASE_URL in your .env and in Render's Environment tab.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One row per thing a shopper does inside the try-on.
model TryOnEvent {
  id           String   @id @default(cuid())
  shop         String
  event        String
  sessionId    String
  visitorId    String
  productId    String?
  productTitle String?
  createdAt    DateTime @default(now())

  @@index([shop, createdAt])
}

// One row per store order placed by a shopper who used try-on first.
model TryOnOrder {
  id              String   @id @default(cuid())
  shop            String
  orderId         String
  orderName       String?
  totalPrice      Float    @default(0)
  currency        String?
  sessionIds      String
  boughtTriedItem Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([shop, orderId])
  @@index([shop, createdAt])
}

// A checkout started by a shopper who used try-on. completedAt is set when it becomes an order.
model TryOnCheckout {
  id              String    @id @default(cuid())
  shop            String
  token           String
  sessionIds      String
  customerId      String?
  customerName    String?
  customerEmail   String?
  customerCity    String?
  customerCountry String?
  itemSummary     String?
  totalPrice      Float     @default(0)
  currency        String?
  recoveryUrl     String?
  completedAt     DateTime?
  startedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([shop, token])
  @@index([shop, updatedAt])
}

// A shopper we could identify because they were logged in to the store while trying on.
model TryOnVisitor {
  id            String   @id @default(cuid())
  shop          String
  visitorId     String
  customerId    String?
  customerName  String?
  customerEmail String?
  updatedAt     DateTime @updatedAt

  @@unique([shop, visitorId])
}